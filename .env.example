# --- Core ---
DISCORD_BOT_TOKEN=REPLACE_WITH_YOUR_TOKEN
DISCORD_CLIENT_ID=
NODE_ENV=production
TIMER_POLL_INTERVAL_SECONDS=30

# --- Guilds ---
GUILD_ID_MAIN=
GUILD_ID_STAFF=

# --- Firebase ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Tickets ---
TICKETS_CATEGORY_ID=
TICKETS_LOG_CHANNEL_ID=
ROLE_ID_BOARD_OF_DIRECTORS=
ROLE_ID_MANAGEMENT_TEAM=
STAFF_PING_ROLE_ID=
ROLE_IDS_TICKET_VIEW=
# Comma-separated. These roles are denied ViewChannel on every ticket channel.
# Leave empty to disable the block list.
ROLE_IDS_TICKET_BLOCKED=

# --- Careers ---
CAREER_SETUP_CHANNEL_ID=
CAREER_REVIEW_CHANNEL_ID=
CAREER_RESULTS_ANNOUNCE_CHANNEL_ID=
SUPPORT_CONTACT_CHANNEL_ID=
ROLE_ID_FLIGHT_DECK=
ROLE_ID_CABIN_CREW=
ROLE_ID_GROUND_CREW=
ROLE_ID_FLIGHT_OPERATOR=
ROLE_ID_HUMAN_RESOURCES=
ROLE_ID_PUBLIC_RELATIONS=

# --- Website / Booking API ---
# Public Discord invite used by the site's "Join Discord" buttons. Served to
# the browser from /api/site/config so it never has to be edited in the site.
# Confirm this code is correct before publishing: the site will 404 a wrong one.
DISCORD_INVITE_URL=
# Sign-in (member dashboard). See SETUP_AUTH.md for the full walkthrough.
# WEBSITE_BASE_URL is the public origin the browser reaches; the OAuth redirect
# is derived from it as <WEBSITE_BASE_URL>/auth/callback and must match the
# redirect registered in the Discord Developer Portal exactly.
WEBSITE_BASE_URL=
WEBSITE_SESSION_SECRET=
DISCORD_OAUTH_CLIENT_SECRET=

# --- Flight Operations ---
FLIGHT_ANNOUNCE_CHANNEL_ID=
FLIGHT_BRIEFING_CHANNEL_ID=
FLIGHT_LOG_CHANNEL_ID=
ROLE_ID_FLIGHT_OPS_COMMANDS=
FLIGHT_PING_ROLE_ID_1=
FLIGHT_PING_ROLE_ID_2=
FLIGHT_BOOKING_STAFF_CHANNEL_ID=
BOOKING_WEBSITE_BASE_URL=
BOOKING_WEBHOOK_SECRET=
BOOKING_API_PORT=3001

# --- LH Rewards / LH Credits ---
REWARDS_LOG_CHANNEL_ID=
ROLE_ID_REWARDS_LEVEL_1=
ROLE_ID_REWARDS_LEVEL_2=
ROLE_ID_REWARDS_LEVEL_3=
# NOTE: There is no new env var for the loyalty/economy system. All rates,
# caps, tier thresholds, multipliers and branding are stored in Firestore at
# config/loyalty and edited at runtime by staff via:
#   /rewards configure ...
#   /economy configure ...
# Brand names ("LH Rewards" / "LH Credits") are configurable there too,
# so they can be renamed without editing code or env.

# --- Paid Ads ---
ADS_CHANNEL_ID=
ADS_SALES_CONTACT_USER_ID=
ROLE_ID_PARTNER=

# --- Ops ---
BOT_OWNER_ID=
ERROR_LOG_CHANNEL_ID=
