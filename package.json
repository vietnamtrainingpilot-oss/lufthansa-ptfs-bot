{
  "name": "lufthansa-ptfs-bot",
  "version": "1.0.0",
  "description": "Lufthansa PTFS Roblox virtual airline Discord bot and flight-booking website",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "node scripts/lint.js",
    "migrate:rewards": "node scripts/migrate-rewards.js --dry-run",
    "migrate:manifests": "node scripts/migrate-manifests.js --dry-run",
    "pm2:start": "pm2 start src/index.js --name vietjet-ptfs-bot",
    "pm2:save": "pm2 save"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "firebase-admin": "^12.0.0",
    "express": "^4.19.0",
    "discord-html-transcripts": "^3.1.3",
    "dotenv": "^16.4.0",
    "body-parser": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}